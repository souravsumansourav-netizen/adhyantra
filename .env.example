# ==============================================================================
# Adhyantra vs Mriganka Performance Dashboard Environment Variables
# Copy this file to .env.local and fill in your values
# ==============================================================================

# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (Public browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authorized Admin Emails (Comma-separated list of emails permitted into /admin)
ADMIN_EMAILS=admin@adhyantra.com,demo@example.com
